#!/bin/sh
# -*- coding: utf-8 -*-
# 勤加软件等保测评助手 - Linux 配置脚本
#
# 用法：
#   ./configure                       # 默认安装到 /usr/local
#   ./configure --prefix=/usr         # 指定安装前缀
#   ./configure --prefix=/opt/ea --python=python3.9
#
# 生成 Makefile 后执行：
#   make            # 检查运行环境
#   sudo make install
#   sudo make uninstall
#   make rpm        # 生成 RPM 安装包
#   make dist       # 生成源码包 tar.gz

set -e

prefix=/usr/local
python=python3
name="qinplus-dengbao"
version="1.0"

usage() {
    cat <<EOF
Usage: ./configure [options]

Options:
  --prefix=DIR        安装前缀（默认 /usr/local，国产系统常用 /usr）
  --python=PATH       指定 python3 解释器（默认 python3）
  --version=VERSION   覆盖版本号（默认 $version）
  --help              显示本帮助
EOF
}

for arg in "$@"; do
    case "$arg" in
        --prefix=*) prefix="${arg#*=}" ;;
        --python=*) python="${arg#*=}" ;;
        --version=*) version="${arg#*=}" ;;
        --help|-h) usage; exit 0 ;;
        *) echo "configure: 未知参数 $arg"; usage; exit 1 ;;
    esac
done

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

[ -f Makefile.in ] || { echo "configure: 缺少 Makefile.in"; exit 1; }

# 检查 Python 解释器
if ! command -v "$python" >/dev/null 2>&1; then
    echo "configure: 未找到 $python，请先安装 python3"
    exit 1
fi

PY_VER="$("$python" -c 'import sys;print(sys.version.split()[0])')"
echo "检查 Python ：$python ($PY_VER)"

# dataclasses 在 Python 3.7+ 为内置模块，3.6 需 pip 安装 backport
MISSING=0
PIP_MIRROR="https://mirrors.aliyun.com/pypi/simple/"
if "$python" -c 'import dataclasses' >/dev/null 2>&1; then
    echo "检查 dataclasses：已就绪（Python 3.7+ 内置）"
else
    echo "检查 dataclasses：未安装（必需，core 模块依赖；Python 3.6 需 backport）"
    echo "            请执行：$python -m pip install -i $PIP_MIRROR dataclasses"
    MISSING=1
fi

if "$python" -c 'import PyQt5' >/dev/null 2>&1; then
    echo "检查 PyQt5  ：已安装（桌面版可用）"
    HAVE_QT=1
else
    echo "检查 PyQt5  ：未安装（桌面版不可用，命令行版仍可安装使用）"
    echo "            请执行：$python -m pip install -i $PIP_MIRROR PyQt5==5.14.2"
    echo "            （Python 3.6 且 pip 较旧时请用 5.14.2，详见 README「Linux 依赖安装常见问题」）"
    HAVE_QT=0
    MISSING=1
fi

if "$python" -c 'import paramiko' >/dev/null 2>&1; then
    echo "检查 paramiko：已安装（SSH 远程检测可用）"
else
    echo "检查 paramiko：未安装（SSH 远程检测不可用）"
    echo "            请执行：$python -m pip install -i $PIP_MIRROR \\"
    echo "                    paramiko==2.12.0 cryptography==3.3.2 bcrypt==3.2.0 pynacl==1.4.0"
    MISSING=1
fi

if "$python" -c 'import docx' >/dev/null 2>&1; then
    echo "检查 python-docx：已安装（Word 报告导出可用）"
else
    echo "检查 python-docx：未安装（Word 报告不可用）"
    echo "            请执行：$python -m pip install -i $PIP_MIRROR python-docx==0.8.11"
    MISSING=1
fi

# 生成 Makefile
sed -e "s|@PREFIX@|$prefix|g" \
    -e "s|@PYTHON@|$python|g" \
    -e "s|@VERSION@|$version|g" \
    Makefile.in > Makefile

echo ""
echo "已生成 Makefile："
echo "  安装前缀 : $prefix"
echo "  桌面版   : $prefix/bin/$name"
echo "  命令行版 : $prefix/bin/$name-cli"
echo "  程序文件 : $prefix/share/$name"
if [ "$MISSING" = "1" ]; then
    echo ""
    echo "注意：仍有依赖未安装，可一次性补齐："
    echo "  $python -m pip install -i $PIP_MIRROR \\"
    echo "      dataclasses PyQt5==5.14.2 paramiko==2.12.0 cryptography==3.3.2 \\"
    echo "      bcrypt==3.2.0 pynacl==1.4.0 python-docx==0.8.11"
fi
echo ""
echo "下一步：make && sudo make install"
echo "打包    ：make rpm   /   make dist"
